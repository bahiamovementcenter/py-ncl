from os import PathLike
from typing import Any

class NickelError(Exception):
    kind: str
    diagnostics: list[dict[str, Any]]

class Source:
    @staticmethod
    def file(path: str | PathLike[str], *, format: str | None = None) -> Source: ...
    @staticmethod
    def code(text: str, *, name: str | None = None, format: str | None = None) -> Source: ...

class PackageMap:
    def __init__(self) -> None: ...
    def add(self, name: str, dir: str | PathLike[str]) -> None: ...
    def add_dependency(
        self, parent: str | PathLike[str], name: str, dir: str | PathLike[str]
    ) -> None: ...
    def packages(self) -> list[tuple[str, str]]: ...
    @staticmethod
    def from_manifest(
        manifest: str | PathLike[str], cache_dir: str | PathLike[str] | None = None
    ) -> PackageMap: ...
    @staticmethod
    def find_manifest(dir: str | PathLike[str]) -> str | None: ...

class Program:
    def eval(self) -> Any: ...
    def export(self, format: str = "json") -> str: ...
    def typecheck(self, *, strict: bool = False) -> None: ...
    def query(self) -> dict[str, Any]: ...
